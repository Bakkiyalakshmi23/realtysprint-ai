# RealtySprint AI Backend Environment Variables
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8000

# Authentication Secrets — replace with secure values locally
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_secure_password

# Database and provider credentials belong in your local .env
# Never commit real credentials to GitHub.
